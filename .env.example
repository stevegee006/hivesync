# Copy to .env and fill in. Never commit .env.

# Required. HiveSync refuses to start without it. Every stored credential is
# encrypted with this key, and the app never persists it. Losing it means
# re-entering every credential.
#   generate with: make secret-key
HIVESYNC_SECRET_KEY=

# Used once, to create the admin account on an empty database. A password change
# is forced at first login, after which this line can be deleted. Minimum 12
# characters.
HIVESYNC_ADMIN_USER=admin
HIVESYNC_ADMIN_PASSWORD=

# local            username and password against the local user table
# none             no authentication, every visitor is the admin. Only behind a
#                  proxy that authenticates for you.
# trusted_header   not implemented yet, arrives in the hardening milestone
HIVESYNC_AUTH_MODE=local

HIVESYNC_LOG_LEVEL=info

# Job schedules default to this timezone.
TZ=America/Denver

# Match these to the owner of your bind mounted host directories.
PUID=1000
PGID=1000

# Set when publishing. See the Docker Hub section of the README.
# HIVESYNC_IMAGE=docker.io/yournamespace/hivesync:latest
