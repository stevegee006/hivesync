# Pinned external tool versions. These are build arguments, sourced by the
# Makefile and passed to `docker build`. Keep CLAUDE.md's version table in sync
# with this file.
#
# rclone digests were read from https://downloads.rclone.org/v1.74.4/SHA256SUMS
# on 2026-08-05. If a digest mismatch stops a build, re-read that file, confirm
# upstream did not republish the release, and update here. Never bypass the check.
RCLONE_VERSION=1.74.4
RCLONE_SHA256_AMD64=fe435e0c36228e7c2f116a8701f01127bb1f694005fc11d1f27186c8bca4115d
RCLONE_SHA256_ARM64=97685285c9ad6a0cf17d5844115d2a67245af6444db672187074bd9c358de419

# Tailwind standalone CLI, a single Go binary. No Node in the build.
# Tailwind publishes no checksum file for these assets, so there is no digest to
# pin. Lower stakes than rclone: this binary only produces CSS.
TAILWIND_VERSION=4.3.3

# Vendored front end libraries, fetched by the assets stage and by `make assets`.
HTMX_VERSION=2.0.10
ALPINE_VERSION=3.15.12

# lftp is intentionally not version pinned. Debian trixie ships one lftp and
# only security patches it, so an exact apt pin converts every future point
# release into a build failure for no safety gain. The build prints the version
# and `make pin-versions` records what the image actually contains.
LFTP_VERSION_OBSERVED=4.9.2

# Base images, pinned by digest. A tag moves; a digest does not, and for lftp
# the digest is also what pins the apt snapshot. Refresh with:
#   docker buildx imagetools inspect python:3.12-slim --format '{{.Manifest.Digest}}'
# These are the multi-arch index digests, so one value covers amd64 and arm64.
PYTHON_IMAGE=python:3.12-slim@sha256:646fb0bca3dd3ea1bcc6feb72c17ed16eed6e10cffc732fcc1478bd3e7f02d7b
DEBIAN_IMAGE=debian:trixie-slim@sha256:3a39a0592364683e6bab97937b72cad5a8fa6dcbbee90edb3bb48c7f8e94f258
